# Browser-safe Supabase values. These are exposed to the React bundle and must be protected by RLS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase secret. Configure only in Cloudflare/Netlify/server runtime secrets.
SUPABASE_SERVICE_ROLE_KEY=server-only-supabase-service-role-key

# Server-only Payzone card checkout settings.
PAYZONE_MERCHANT_ACCOUNT=your-payzone-merchant-account
PAYZONE_PAYWALL_SECRET_KEY=server-only-payzone-paywall-secret-key
PAYZONE_NOTIFICATION_KEY=server-only-payzone-notification-key
PAYZONE_PAYWALL_URL=https://payment-sandbox.payzone.ma/pwv4/launch
PAYZONE_CURRENCY=MAD
PAYZONE_CUSTOMER_COUNTRY=MA
PAYZONE_CUSTOMER_LOCALE=en_US
PAYZONE_SKIN=vps-1-vue
PAYZONE_CALLBACK_URL=https://your-domain.com/api/payzone/callback
PAYZONE_SUCCESS_URL=https://your-domain.com/payment/success
PAYZONE_FAILURE_URL=https://your-domain.com/payment/failure
PAYZONE_CANCEL_URL=https://your-domain.com/payment/cancel

# Optional fallback generic hosted card/payment gateway settings.
PAYMENT_GATEWAY_PROVIDER=external_gateway
PAYMENT_GATEWAY_API_URL=https://your-payment-gateway.example.com/create-checkout
PAYMENT_GATEWAY_SECRET_KEY=server-only-payment-gateway-secret-key

# Server-only NOWPayments crypto checkout settings.
NOWPAYMENTS_API_KEY=server-only-nowpayments-api-key
NOWPAYMENTS_IPN_SECRET=server-only-nowpayments-ipn-secret
NOWPAYMENTS_IPN_CALLBACK_URL=https://your-domain.com/api/nowpayments/ipn
NOWPAYMENTS_SUCCESS_URL=https://your-domain.com/payment/success
NOWPAYMENTS_CANCEL_URL=https://your-domain.com/payment/cancel

# Server-only Discord integration settings.
DISCORD_CLIENT_ID=discord-client-id
DISCORD_CLIENT_SECRET=server-only-discord-client-secret
DISCORD_REDIRECT_URI=https://your-domain.com/discord/callback
DISCORD_BOT_TOKEN=server-only-discord-bot-token
DISCORD_GUILD_ID=discord-guild-id
DISCORD_VERIFIED_MEMBER_ROLE_ID=discord-verified-member-role-id
DISCORD_MENTORSHIP_ROLE_ID=discord-role-id
DISCORD_ONE_TO_ONE_ROLE_ID=discord-role-id
DISCORD_GROUP_ROLE_ID=discord-role-id
DISCORD_LIVE_TRADING_ROLE_ID=discord-role-id
DISCORD_NEWS_ROLE_ID=discord-role-id
DISCORD_REMOVE_EXPIRED_MEMBERS=false
# Local testing only. Keep false/empty in production so unpaid pending checkouts do not get roles.
DISCORD_ALLOW_PENDING_ACCESS=false
DISCORD_CRON_SECRET=server-only-random-cron-secret

# Optional Payzone deep link. Leave disabled to let Payzone show enabled methods.
PAYZONE_PAYMENT_METHOD=
PAYZONE_FORCE_DEEP_LINK=false
